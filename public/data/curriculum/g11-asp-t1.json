    {
     "q": "A bacterium grows from 5,000 cells to 12,000 cells in 10 hours. At this rate, about how many cells will there be after 36 hours?",
     "options": [
      "98,365",
      "116,877",
      "154,324",
      "197,633"
     ],
     "answer": 1,
     "hint": "Model N = 5000 · (12000/5000)^(t/10).",
     "explanation": "N = 5000 · 2.4^3.6 ≈ 5000 × 23.38 ≈ 116,877.",
     "source": "course",
     "id": "g11-asp-t1-logarithmic-and-exponential-functions-1"
    },
    {
     "q": "A substance has a half-life of 30 days and 240 g is present initially. After how many days will only 20 g remain?",
     "options": [
      "97.891",
      "107.549",
      "120",
      "137.549"
     ],
     "answer": 1,
     "hint": "Solve 240(½)^(t/30) = 20.",
     "explanation": "(½)^(t/30) = 1/12, so t = 30 · log(12)/log(2) ≈ 107.549 days.",
     "source": "course",
     "id": "g11-asp-t1-logarithmic-and-exponential-functions-2"
    },
